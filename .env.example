# ── Blockchain (samakan dengan sigap-api/.env.example) ──
RPC_URL="https://rpc-amoy.polygon.technology"
CHAIN_ID=80002

# Private key deployer testnet — HEX 64 karakter, diawali 0x. JANGAN pernah
# commit key sungguhan. Kosongkan/biarkan placeholder untuk kompilasi & test
# lokal (Hardhat network) — cuma dibutuhkan saat benar-benar deploy ke `amoy`.
ADMIN_PRIVATE_KEY="0x_your_deployer_private_key"

# Wallet governance (multisig) yang pegang DEFAULT_ADMIN_ROLE di BansosRegistry.
# Lihat docs/06-Smart-Contract-Design.md §3.1 — BUKAN wallet individu.
GOVERNANCE_ADDRESS="0x..."

# Diisi otomatis oleh scripts/deploy.ts setelah deploy — salin ke sigap-api/.env
# (REGISTRY_CONTRACT_ADDRESS/DISBURSEMENT_CONTRACT_ADDRESS/DANA_TOKEN_ADDRESS)
# supaya backend bisa mulai memanggil kontrak sungguhan.
